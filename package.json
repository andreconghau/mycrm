{
  "name": "seafood-export-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write package.json '*.mjs' '*.json' '*.{ts,mts}' 'src/**/*.{ts,tsx,css}' 'e2e/**/*.ts'",
    "format:check": "prettier --check package.json '*.mjs' '*.json' '*.{ts,mts}' 'src/**/*.{ts,tsx,css}' 'e2e/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:validate-migrations": "tsx scripts/validate-migrations.ts",
    "access:operator": "tsx scripts/access-control.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "postgres": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swagger-ui-dist": "5.34.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "scarfSettings": {
    "enabled": false
  }
}
