# Server-side PostgreSQL connection for the planned Drizzle/Postgres.js adapter.
# Replace the placeholder and keep credentials out of NEXT_PUBLIC_* variables.
# URL-encode reserved characters in the password.
DATABASE_URL=postgresql://crm_app:replace-me@127.0.0.1:5432/seafood_crm
DATABASE_POOL_MAX=5

# Authentication secrets must be independently generated and at least 32 bytes.
# Keep previous keys only during a planned key-rotation window.
AUTH_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_CSRF_SECRET=replace-with-a-different-32-character-secret
AUTH_ISSUER=seafood-export-crm
AUTH_AUDIENCE=seafood-export-crm-web
APP_ORIGIN=http://127.0.0.1:3000


NIMBALYST_TRACKER_ADAPTER=/path/to/nimbalyst-tracker-list