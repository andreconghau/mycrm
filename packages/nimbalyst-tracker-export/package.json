{
  "name": "@nimbalyst/tracker-export",
  "version": "0.1.0",
  "description": "Export Nimbalyst tracker items to durable Markdown snapshots.",
  "type": "module",
  "bin": {
    "nimbalyst-tracker-export": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  }
}
